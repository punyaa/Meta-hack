# Create a Model API key in the Meta developer dashboard.
# Never commit the real value.
MODEL_API_KEY=

MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
SIGNALFORGE_DEMO_MODE=false
MAX_IMAGES=15
RETENTION_HOURS=24

# Serverless (Vercel) flow. Local default: storage=memory-backed v1 flow.
# Vercel: create a Blob store, connect it to the project, and set:
# STORAGE_BACKEND=blob
# JOB_BACKEND=blob
# BLOB_READ_WRITE_TOKEN is added automatically when the store is connected.
# WEB_FLOW=v2 forces the stepwise flow locally for testing.

# Accounts + history (Vercel Postgres). When POSTGRES_URL is unset, the app
# stays open and nothing is recorded. Use the pooled connection string.
# POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
# Google Drive folder import (Google Cloud Console key with Drive API enabled).
# GOOGLE_API_KEY=

